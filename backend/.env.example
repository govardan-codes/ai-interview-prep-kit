# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (or local) connection string
MONGODB_URI=

# Secret used to sign session/JWT tokens - use a long random string
JWT_SECRET=

# Google Gemini API key - https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=

# Gemini model name (gemini-1.5-flash was retired by Google; gemini-2.5-flash
# is the current free-tier Flash model as of writing - check
# https://ai.google.dev/gemini-api/docs/models before you submit in case
# Google has moved the free tier to a newer model by then)
GEMINI_MODEL=gemini-2.5-flash

# Max pages fetched per company crawl
CRAWL_MAX_PAGES=6

# Max coverage-check passes before giving up
MAX_COVERAGE_PASSES=3
